              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "required": [
            "store"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_recent_orders",
        "title": "List recent orders",
        "description": "List the most recent orders for a store owned by the signed-in user. Pass the store's id (uuid) or slug.",
